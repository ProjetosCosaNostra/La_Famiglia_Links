/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; manifest-src 'self'

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin.js
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
