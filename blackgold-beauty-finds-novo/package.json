{
  "name": "blackgold-beauty-finds-novo",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev . --port 8768 --persist-to .wrangler/state",
    "db:init": "wrangler d1 migrations apply blackgold-beauty-finds-novo --local",
    "verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./tools/verify.ps1",
    "test:backend": "node tools/backend_flow.mjs",
    "test:admin-ui": "node tools/admin_ui_flow.mjs",
    "backup": "node tools/catalog_backup.mjs",
    "restore": "node tools/catalog_restore.mjs",
    "test:backup": "node tools/backup_restore_roundtrip.mjs",
    "test:storefront": "node tools/storefront_ui_flow.mjs",
    "release:check": "node tools/release_preflight.mjs",
    "release:expect-blocked": "node tools/release_preflight.mjs --expect-blocked",
    "deploy:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./tools/deploy-production.ps1",
    "build:production": "node tools/build-production.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.16.0",
    "wrangler": "^4.38.0"
  }
}
