{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blackgold.affiliate-activation-approval/v1",
  "title": "BlackGold affiliate activation approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "market",
    "approval_id",
    "proposal_id",
    "product_id",
    "program_id",
    "decision",
    "approved_at",
    "explicit_confirmation"
  ],
  "properties": {
    "schema": {"const": "blackgold.affiliate-activation-approval/v1"},
    "project": {"const": "BlackGold Beauty Finds"},
    "market": {"const": "US"},
    "approval_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "proposal_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "product_id": {"type": "string", "pattern": "^bg-us-[0-9]{4}$"},
    "program_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "decision": {"const": "approve"},
    "approved_at": {"type": "string", "format": "date-time"},
    "explicit_confirmation": {"const": true},
    "note": {"type": "string", "maxLength": 500}
  }
}