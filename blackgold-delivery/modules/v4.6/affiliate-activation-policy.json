{
  "schema": "blackgold.affiliate-activation-policy/v4.6",
  "project": "BlackGold Beauty Finds",
  "market": "US",
  "default": "deny",
  "approval_schema": "blackgold.affiliate-activation-approval/v2",
  "approval_inbox": ".blackgold/inbox/affiliate-activation-approval.json",
  "candidate_store": ".blackgold/commerce/retailer-link-candidates.json",
  "live_registry": ".blackgold/staging/experience-v2.9/data/retailer-links.json",
  "products_registry": ".blackgold/staging/experience-v2.9/data/products.json",
  "program_registry": ".blackgold/staging/experience-v2.9/data/affiliate-programs.us.json",
  "retailer_policy": ".blackgold/staging/experience-v2.9/retailer-policy.json",
  "release_gate": "tools/blackgold_release_gate_v42/release_gate.py",
  "max_approval_age_hours": 48,
  "max_candidate_verification_age_days": 7,
  "require_program_status": "program_verified",
  "require_application_status": "approved",
  "require_candidate_state": "candidate",
  "require_candidate_hash_binding": true,
  "require_network_generated_tracking": true,
  "require_exact_product_verification": true,
  "network_recheck_required": true,
  "single_use_approval": true,
  "single_use_proposal": true,
  "require_live_route_state": "locked",
  "write_live_registry_only_after_all_gates": true,
  "rollback_on_release_gate_failure": true,
  "activation_receipt_required": true,
  "public_site_changes": false,
  "notes": [
    "Approval v2 is bound to the exact imported candidate SHA-256.",
    "Changing a candidate URL after approval invalidates that approval.",
    "An approval_id and proposal_id are single-use after activation.",
    "Installing this policy does not activate any affiliate route.",
    "A proposal is not an approval and program existence is not publisher-account approval.",
    "Any failed gate keeps the shopper route locked."
  ]
}
